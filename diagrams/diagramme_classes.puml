@startuml
class Utilisateur {
  +id: int
  +full_name: String
  +email: String
  +phone: String
  +user_type: TypeUsager
  +role: RoleApplicatif
  +password_hash: String
  +is_suspended: Boolean
  +suspension_reason: String
  +suspension_origin: OrigineSuspension
  +suspension_date: date
  +changerMotDePasse(): bool
}

enum RoleApplicatif {
  admin
  user
}

enum TypeUsager {
  adherent
  enseignant
  administrateur
}

enum OrigineSuspension {
  auto
  manual
}

class Livre {
  +id: int
  +title: String
  +author: String
  +isbn: String
  +publisher: String
  +publication_year: int
  +total_copies: int
  +available_copies: int
}

class DemandeEmprunt {
  +id: int
  +request_date: date
  +status: StatutDemande
}

enum StatutDemande {
  pending
  approved
  rejected
}

class Emprunt {
  +id: int
  +loan_date: date
  +due_date: date
  +return_date: date
}

class Reservation {
  +id: int
  +reservation_date: date
  +status: StatutReservation
}

enum StatutReservation {
  active
  closed
}

class ServiceCompte {
  +changerMotDePassePersonnel(user_id, current_password, new_password)
  +reinitialiserMotDePasseUsager(admin_id, user_id, new_password)
}

class ServiceSuspension {
  +syncUserSuspensions()
}

Utilisateur "1" -- "0..*" DemandeEmprunt : effectue
Livre "1" -- "0..*" DemandeEmprunt : concerne
Utilisateur "1" -- "0..*" Emprunt : possede
Livre "1" -- "0..*" Emprunt : fait l'objet de
Utilisateur "1" -- "0..*" Reservation : cree
Livre "1" -- "0..*" Reservation : reserve

DemandeEmprunt ..> Emprunt : <<create>> si approuvee
Emprunt ..> Utilisateur : retard => suspension auto
ServiceCompte ..> Utilisateur : <<service>>
ServiceSuspension ..> Utilisateur : <<service>>
ServiceSuspension ..> Emprunt : <<service>>
@enduml
