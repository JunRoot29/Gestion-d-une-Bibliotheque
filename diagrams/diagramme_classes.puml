@startuml
class User {
  +id: int
  +full_name: str
  +email: str
  +phone: str
  +user_type: str
  +role: Role
  +password_hash: str
}

enum Role {
  admin
  user
}

class Book {
  +id: int
  +title: str
  +author: str
  +isbn: str
  +publisher: str
  +publication_year: int
  +total_copies: int
  +available_copies: int
}

class LoanRequest {
  +id: int
  +request_date: date
  +status: LoanRequestStatus
}

enum LoanRequestStatus {
  pending
  approved
  rejected
}

class Loan {
  +id: int
  +loan_date: date
  +due_date: date
  +return_date: date
}

class Reservation {
  +id: int
  +reservation_date: date
  +status: ReservationStatus
}

enum ReservationStatus {
  active
  closed
}

User "1" -- "0..*" LoanRequest
Book "1" -- "0..*" LoanRequest
User "1" -- "0..*" Loan
Book "1" -- "0..*" Loan
User "1" -- "0..*" Reservation
Book "1" -- "0..*" Reservation

LoanRequest ..> Loan : approved -> create loan
@enduml
