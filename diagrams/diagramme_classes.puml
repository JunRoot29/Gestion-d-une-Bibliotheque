@startuml
class Utilisateur {
  +id: int
  +full_name: str
  +email: str
  +phone: str
  +user_type: TypeUsager
  +role: RoleApplicatif
  +password_hash: str
  +is_suspended: bool
  +suspension_reason: str
  +suspension_origin: OrigineSuspension
  +suspension_date: date
  +changerMotDePasse(): bool
}

enum RoleApplicatif {
  admin
  user
}

enum TypeUsager {
  adherent
  enseignant
  administrateur
}

enum OrigineSuspension {
  auto
  manual
}

class Livre {
  +id: int
  +title: str
  +author: str
  +isbn: str
  +publisher: str
  +publication_year: int
  +total_copies: int
  +available_copies: int
}

class DemandeEmprunt {
  +id: int
  +request_date: date
  +status: StatutDemande
}

enum StatutDemande {
  pending
  approved
  rejected
}

class Emprunt {
  +id: int
  +loan_date: date
  +due_date: date
  +return_date: date
}

class Reservation {
  +id: int
  +reservation_date: date
  +status: StatutReservation
}

enum StatutReservation {
  active
  closed
}

class ServiceCompte {
  +changerMotDePassePersonnel(user_id, current_password, new_password)
  +reinitialiserMotDePasseUsager(admin_id, user_id, new_password)
}

class ServiceSuspension {
  +syncUserSuspensions()
}

Utilisateur "1" -- "0..*" DemandeEmprunt
Livre "1" -- "0..*" DemandeEmprunt
Utilisateur "1" -- "0..*" Emprunt
Livre "1" -- "0..*" Emprunt
Utilisateur "1" -- "0..*" Reservation
Livre "1" -- "0..*" Reservation

DemandeEmprunt ..> Emprunt : approved -> creer emprunt
Emprunt ..> Utilisateur : retard -> suspension auto
ServiceCompte ..> Utilisateur
ServiceSuspension ..> Utilisateur
ServiceSuspension ..> Emprunt
@enduml
