@startuml
left to right direction
actor "Bibliothécaire" as B
actor "Usager" as U
actor "Administrateur" as A

rectangle "Système de gestion de bibliothèque" {
  usecase "S'authentifier" as UC1
  usecase "Rechercher un ouvrage" as UC2
  usecase "Consulter disponibilité" as UC3
  usecase "Emprunter un ouvrage" as UC4
  usecase "Retourner un ouvrage" as UC5
  usecase "Réserver un ouvrage" as UC6
  usecase "Annuler réservation" as UC7
  usecase "Gérer usagers" as UC8
  usecase "Gérer ouvrages" as UC9
  usecase "Calculer pénalité retard" as UC10
  usecase "Consulter historique" as UC11
}

U --> UC1
U --> UC2
U --> UC3
U --> UC6
U --> UC7
U --> UC11

B --> UC1
B --> UC4
B --> UC5
B --> UC2
B --> UC3
B --> UC10
B --> UC11

A --> UC1
A --> UC8
A --> UC9

UC4 .> UC3 : <<include>>
UC5 .> UC10 : <<include>>
UC6 .> UC3 : <<include>>
@enduml
