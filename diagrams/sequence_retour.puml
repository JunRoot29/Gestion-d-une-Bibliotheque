@startuml
actor Administrateur
participant "UI Admin" as UI
participant "Flask App" as APP
database DB

Administrateur -> UI : Enregistrer le retour d'un emprunt
UI -> APP : POST /loans (action=return, loan_id)
APP -> DB : SELECT loan by id
alt Emprunt introuvable ou deja retourne
  APP --> UI : Message d'erreur
else Emprunt actif
  APP -> DB : UPDATE loans SET return_date = date('now')
  APP -> DB : UPDATE books SET available_copies = available_copies + 1
  APP --> UI : Retour enregistre
end
@enduml
