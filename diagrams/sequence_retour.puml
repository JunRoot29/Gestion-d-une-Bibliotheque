@startuml
actor "Administrateur" as A
participant "Interface Admin" as UI
participant "Application Flask" as APP
database "SQLite" as DB

== Retour d'un emprunt ==
A -> UI : Cloturer retour d'un emprunt
UI -> APP : POST /loans (action=return, loan_id)
APP -> DB : sync_user_suspensions()
APP -> DB : Charger emprunt par loan_id

alt [Emprunt introuvable ou deja retourne]
  APP --> UI : Erreur (retour impossible)
else Emprunt actif
  APP -> DB : UPDATE loans SET return_date = date('now')
  APP -> DB : UPDATE books SET available_copies = available_copies + 1
  APP -> DB : sync_user_suspensions()
  APP --> UI : Retour enregistre
end
@enduml
