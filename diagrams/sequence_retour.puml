@startuml
actor Administrateur
participant "Interface Admin" as UI
participant "Application Flask" as APP
database BaseDeDonnées as DB

== Retour d'un emprunt ==
Administrateur -> UI : Enregistrer le retour d'un emprunt
UI -> APP : POST /emprunts (action=retour, id_emprunt)
APP -> DB : Synchroniser suspensions
APP -> DB : Sélectionner emprunt par identifiant

alt [Emprunt introuvable ou déjà retourné]
  APP --> UI : Erreur (emprunt non valide)
else [Emprunt actif]
  APP -> DB : UPDATE emprunts SET date_retour = aujourd'hui
  APP -> DB : UPDATE ouvrages SET exemplaires_disponibles = exemplaires_disponibles + 1
  APP -> DB : Synchroniser suspensions
  APP --> UI : Retour enregistré
end
@enduml
