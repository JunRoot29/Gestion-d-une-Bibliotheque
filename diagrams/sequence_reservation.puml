@startuml
actor "Usager" as U
actor "Administrateur" as A
participant "Interface Usager" as UUI
participant "Interface Admin" as AUI
participant "Application Flask" as APP
database "SQLite" as DB

== Creer une reservation ==
U -> UUI : Cliquer sur "Reserver"
UUI -> APP : POST /me/reservations (book_id)
APP -> DB : sync_user_suspensions()
APP -> DB : Charger user courant

alt [Usager suspendu]
  APP --> UUI : Refus (compte suspendu)
else Usager actif
  APP -> DB : Verifier livre existe
  APP -> DB : Verifier reservation active deja presente
  APP -> DB : Verifier emprunt actif deja present

  alt [Contrainte invalide]
    APP --> UUI : Refus de reservation
  else Reservation valide
    APP -> DB : INSERT reservations(status='active')
    APP --> UUI : Reservation enregistree
  end
end

== Annuler sa reservation ==
U -> UUI : Annuler une reservation
UUI -> APP : POST /me/reservations/{id}/cancel
APP -> DB : UPDATE reservations status='closed'
note right
Condition SQL:
id = {id}
AND user_id = courant
AND status = 'active'
end note
APP --> UUI : Reservation annulee

== Cloturer cote admin ==
A -> AUI : Cloturer une reservation
AUI -> APP : POST /reservations/{id}/close
APP -> DB : UPDATE reservations status='closed'
APP --> AUI : Reservation cloturee
@enduml
