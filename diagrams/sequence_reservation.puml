@startuml
actor Adhérent
actor Administrateur
participant "Interface Adhérent" as UUI
participant "Interface Admin" as AUI
participant "Application Flask" as APP
database BaseDeDonnées as DB

== Réserver un ouvrage ==
Adhérent -> UUI : Réserver un ouvrage
UUI -> APP : POST /moi/reservations (id_ouvrage)
APP -> DB : Synchroniser suspensions
APP -> DB : Charger utilisateur courant

alt [Usager suspendu]
  APP --> UUI : Refus (compte suspendu)
else [Usager actif]
  APP -> DB : INSERT reservations(statut='active')
  APP --> UUI : Réservation enregistrée
end

== Annuler une réservation ==
Adhérent -> UUI : Annuler sa réservation
UUI -> APP : POST /moi/reservations/{id}/annuler
APP -> DB : UPDATE reservations statut='clôturée'
note right
Condition SQL :
statut='active' AND utilisateur_id = courant
end note
APP --> UUI : Réservation annulée

== Clôturer une réservation ==
Administrateur -> AUI : Clôturer une réservation
AUI -> APP : POST /reservations/{id}/clôturer
APP -> DB : UPDATE reservations statut='clôturée'
APP --> AUI : Réservation clôturée
@enduml
