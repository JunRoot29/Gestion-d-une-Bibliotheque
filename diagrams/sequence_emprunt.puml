@startuml
actor Adhérent
actor Administrateur
participant "Interface Adhérent" as UUI
participant "Interface Admin" as AUI
participant "Application Flask" as APP
database BaseDeDonnées as DB

== Demande d'emprunt ==
Adhérent -> UUI : Choisir un ouvrage
UUI -> APP : POST /moi/demandes-emprunt (id_ouvrage)
APP -> DB : Synchroniser suspensions
APP -> DB : Charger utilisateur courant

alt [Usager suspendu]
  APP --> UUI : Refus (compte suspendu)
else [Usager actif]
  APP -> DB : Vérifier demande en attente
  alt [Demande déjà en attente]
    APP --> UUI : Erreur (demande déjà en attente)
  else [Nouvelle demande]
    APP -> DB : INSERT demandes_emprunt(statut='en_attente')
    APP --> UUI : Demande envoyée
  end
end

== Validation par administrateur ==
Administrateur -> AUI : Ouvrir liste des demandes
AUI -> APP : POST /emprunts (action=approuver, date_limite)
APP -> DB : Vérifier date_limite >= aujourd'hui

alt [Date limite invalide]
  APP --> AUI : Refus de validation
else [Date valide]
  APP -> DB : Charger demande en attente
  APP -> DB : Vérifier usager non suspendu
  APP -> DB : Vérifier exemplaires disponibles

  alt [Demande invalide / usager suspendu / stock insuffisant]
    APP --> AUI : Refus de validation
  else [Approbation possible]
    APP -> DB : UPDATE demandes_emprunt statut='approuvée'
    APP -> DB : INSERT emprunts(utilisateur_id, ouvrage_id, date_limite)
    APP -> DB : UPDATE ouvrages exemplaires_disponibles = exemplaires_disponibles - 1
    APP --> AUI : Emprunt créé
  end
end

== Rejet d'une demande ==
Administrateur -> AUI : Rejeter une demande
AUI -> APP : POST /emprunts (action=rejeter)
APP -> DB : UPDATE demandes_emprunt statut='rejetée'
APP --> AUI : Demande rejetée
@enduml
