@startuml
actor "Usager" as U
actor "Administrateur" as A
participant "Interface Catalogue" as UUI
participant "Interface Admin" as AUI
participant "Application Flask" as APP
database "SQLite" as DB

== Demande d'emprunt usager ==
U -> UUI : Choisir un livre
UUI -> APP : POST /me/loan-requests (book_id)
APP -> DB : sync_user_suspensions()
APP -> DB : Charger user courant

alt [Usager suspendu]
  APP --> UUI : Refus (compte suspendu)
else Usager actif
  APP -> DB : Verifier livre existe
  APP -> DB : Verifier available_copies > 0
  APP -> DB : Verifier demande pending deja presente
  APP -> DB : Verifier emprunt actif deja present

  alt [Contrainte invalide]
    APP --> UUI : Refus de creation de demande
  else Demande valide
    APP -> DB : INSERT loan_requests(status='pending')
    APP --> UUI : Demande envoyee
  end
end

== Validation admin ==
A -> AUI : Ouvrir les demandes en attente
AUI -> APP : POST /loans (action=approve_request, due_date)
APP -> DB : Verifier due_date >= aujourd'hui
APP -> DB : sync_user_suspensions()
APP -> DB : Charger demande pending
APP -> DB : Verifier user non suspendu
APP -> DB : Verifier livre disponible

alt [Validation impossible]
  APP --> AUI : Refus de validation
else Validation OK
  APP -> DB : UPDATE loan_requests status='approved'
  APP -> DB : INSERT loans(user_id, book_id, due_date)
  APP -> DB : UPDATE books available_copies = available_copies - 1
  APP --> AUI : Emprunt cree
end

== Rejet admin ==
A -> AUI : Rejeter une demande
AUI -> APP : POST /loans (action=reject_request)
APP -> DB : UPDATE loan_requests status='rejected'
APP --> AUI : Demande rejetee
@enduml
